# Payment provider: "mock" (default demo/dev) or "razorpay" (Test Mode)
PAYMENT_PROVIDER=mock

# Razorpay TEST mode credentials (https://dashboard.razorpay.com -> Test mode)
# Only required when PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Secret used by the mock provider to sign simulated payments/webhooks
MOCK_PAYMENT_SECRET=mock_secret_dev_only

# LLM (Google Gemini) - used by the AI agents for tool calling
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database
DATABASE_URL=sqlite:///./revpilot.db

# CORS / frontend origin
FRONTEND_ORIGIN=http://localhost:5173
